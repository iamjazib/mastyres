# MAS Tyres Invoice App Email Configuration
# Admin email where invoice submissions will be sent
ADMIN_EMAIL=jazib7563@gmail.com

# -------------------------------------------------------------
# OPTION 1: GMAIL SMTP (Recommended for personal Gmail accounts)
# -------------------------------------------------------------
# 1. Go to your Google Account -> Security
# 2. Make sure 2-Step Verification is turned ON
# 3. Go to "App passwords" (https://myaccount.google.com/apppasswords)
# 4. Generate an App Password for "Mail" / "MAS Tyres" (16 letters, e.g. "abcd efgh ijkl mnop")
# 5. Paste your Gmail and App Password below (uncomment lines):
# SMTP_SERVICE=gmail
# SMTP_USER=jazib7563@gmail.com
# SMTP_PASS=your-16-character-app-password

# -------------------------------------------------------------
# OPTION 2: CUSTOM SMTP (Brevo, SendGrid, Hostinger, cPanel, etc.)
# -------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="MAS Tyres" <no-reply@mastyres.co.uk>
